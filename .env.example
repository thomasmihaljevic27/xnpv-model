# ---------------------------------------------------------------------------
# xNPV Model environment template
#
# Copy to .env and fill in real paths. .env is gitignored and never committed.
#
# WHY THIS EXISTS: several scripts currently carry absolute Windows paths
# baked into a DB_PATH constant (for example a Desktop\test\ path to the
# game-log database). In a public repo those leak the machine layout and
# break for anyone else. Extracting them is a prerequisite task, not
# optional cleanup. See the migration checklist in README.md.
# ---------------------------------------------------------------------------

# Repo root. Everything else resolves relative to this.
XNPV_ROOT=C:/path/to/xnpv-model

# The canonical game-log store. 2.3 GB, never synced to the repo.
# PROJECT_STATE records this as the only copy carrying gv_adjusted and
# player_game_value. The older new_scrape path is superseded.
GAMELOG_DB=C:/path/to/nhl_gamelogs.sqlite

# Standard tree locations. Override only if the layout changes.
SOURCE_DIR=${XNPV_ROOT}/10_SOURCE
CODE_DIR=${XNPV_ROOT}/20_CODE
OUTPUT_DIR=${XNPV_ROOT}/30_OUTPUT
STATE_DIR=${XNPV_ROOT}/00_STATE

# Dropbox working copy. Sync channel only, never the source of truth.
# Local wins whenever the two disagree.
DROPBOX_ROOT=C:/Users/<you>/Dropbox/Lakehead/xNPV Model

# Supporting databases in 10_SOURCE.
CLAUSES_DB=${SOURCE_DIR}/capspace_clauses.db
TRADES_DB=${SOURCE_DIR}/trades.db
EP_AGES_DB=${SOURCE_DIR}/ep_ages.db

# Scraper identification. Use a contact address you are willing to publish,
# or a generic project string. Do not commit a personal email.
SCRAPER_USER_AGENT=xnpv-model/1.0 (academic research)
