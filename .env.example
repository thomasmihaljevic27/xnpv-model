# ---------------------------------------------------------------------------
# xNPV Model environment template
#
# Copy to .env and fill in real paths. .env is gitignored and never committed.
#
# WHY THIS EXISTS: several scripts currently carry absolute Windows paths
# baked into a DB_PATH constant (for example a Desktop\test\ path to the
# game-log database). In a public repo those leak the machine layout and
# break for anyone else. Extracting them is a prerequisite task, not
# optional cleanup. See the migration checklist in README.md.
# ---------------------------------------------------------------------------

# Repo root. Everything else resolves relative to this.
XNPV_ROOT=C:/path/to/xnpv-model

# The canonical game-log store. 2.3 GB, never synced to the repo.
# PROJECT_STATE records this as the only copy carrying gv_adjusted and
# player_game_value. The older new_scrape path is superseded.
# Read by: check.py, xg_model.py, score_state.py, metric_assembly.py,
# on_ice_reconstruction.py, replacement_rebase.py, term_premium_test.py,
# gv_adjusted_build.py, gv_old_vs_new_compare.py, gv_playoff_check.py,
# gv_4b_circularity_check.py, gv_4b_robustness_check.py.
GAMELOG_DB=C:/path/to/nhl_gamelogs.sqlite

# Where nhl_gamelog_scraper.py writes: its raw NHL-API JSON cache and the
# working copy of nhl_gamelogs.sqlite it builds. Deliberately NOT the
# GAMELOG_DB directory -- a fresh scrape must not overwrite the canonical
# store in place. Promote to GAMELOG_DB manually once a scrape is verified.
SCRAPE_OUT_DIR=C:/path/to/scrape_workdir

# Standard tree locations. Override only if the layout changes.
#
# The player and draft pillars split their file reads across these two: a
# vendor input (WAR.csv, Goalies_WAR.csv, nhle_temporal.csv,
# draft_slot_baseline.csv) resolves against SOURCE_DIR and is never written;
# a generated file (WAR_with_age.csv, contract_season_spine.csv,
# contract_level_spine.csv, every *_value_spine.csv, contract_npv_spine.csv,
# the panels, the draft/yield curves, the run logs, and the capspace_out/
# and ep_out/ scraper subtrees) resolves against OUTPUT_DIR. The retired
# XNPV_DATA variable used to collapse both into one flat folder.
# CODE_DIR is on sys.path for the driver scripts that import a sibling
# (uncertainty_correction*.py, retention_recalibration_check.py).
SOURCE_DIR=${XNPV_ROOT}/10_SOURCE
CODE_DIR=${XNPV_ROOT}/20_CODE
OUTPUT_DIR=${XNPV_ROOT}/30_OUTPUT
STATE_DIR=${XNPV_ROOT}/00_STATE

# Dropbox working copy. Sync channel only, never the source of truth.
# Local wins whenever the two disagree.
DROPBOX_ROOT=C:/Users/<you>/Dropbox/Lakehead/xNPV Model

# Generated databases under 30_OUTPUT, all written by code (never 10_SOURCE):
#   capspace_clauses.db  capspace_scraper.py, alongside its CSV
#   ep_ages.db           ep_age_scraper.py's resumable cache
#   ep_prospects.db      ep_extract.py's production store
CLAUSES_DB=${OUTPUT_DIR}/capspace_out/capspace_clauses.db
EP_AGES_DB=${OUTPUT_DIR}/ep_out/ep_ages.db
EP_PROSPECTS_DB=${OUTPUT_DIR}/ep_out/ep_prospects.db

# PuckPedia exports. Confidential vendor data, never committed (gitignored by
# name). Point each at the local .xlsx on the machine running the script.
# Read by: capspace_scraper.py (both), ep_extract.py (trades only).
PUCKPEDIA_CONTRACTS_XLSX=C:/path/to/PuckPedia_Player_Contract_Export.xlsx
PUCKPEDIA_TRADES_XLSX=C:/path/to/PuckPedia_Trades_Contract_Export.xlsx

# Scraper identification. Use a contact address you are willing to publish,
# or a generic project string. Do not commit a personal email.
SCRAPER_USER_AGENT=xnpv-model/1.0 (academic research)
